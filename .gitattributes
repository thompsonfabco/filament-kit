# Scripts and unit files run on Linux: always LF, whatever core.autocrlf says.
*.sh       text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.path     text eol=lf
install/remote/* text eol=lf
*.yml      text eol=lf
*.bat      text eol=crlf
gradlew    text eol=lf

# The spec library snapshot and its test fixture are hashed byte for byte (index.json sha256).
server/filament_kit/library_data/** -text
server/tests/data/library_snapshot/** -text
server/tests/data/library/** -text

# The panel firmware the station flashes is a binary, byte for byte.
station/panel/firmware/*.bin binary

# The family build golden files are compared byte for byte (test_builds_orca.py).
server/tests/data/golden/** -text

# Test fixtures are read byte for byte (golden builds are made from them): no CRLF on Windows checkouts.
server/tests/data/** -text
printer-pack/** text eol=lf

# Design sources and what build_tokens.py generates from them: its --check compares byte for byte with "\n" endings, so
# a CRLF checkout would fail it (docs/design/08-platform-mapping.md 1). Listed now for the outputs later steps add.
tokens/** text eol=lf
icons/** text eol=lf
server/filament_kit/shared_static/** text eol=lf
strings/** text eol=lf
web-shared/** text eol=lf
android/app/src/main/java/**/ui/theme/SpoolwardenTokens.kt text eol=lf
android/app/src/main/res/values/strings.xml text eol=lf
android/app/src/main/res/values*/sw_window.xml text eol=lf
android/app/src/main/res/drawable/sw_*.xml text eol=lf

# esptool-js, vendored as published (THIRD-PARTY.md has its SHA-256): byte for byte.
server/filament_kit/setup_static/esptool.bundle.js -text
