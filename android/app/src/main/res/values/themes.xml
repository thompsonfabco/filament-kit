<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind the first frame; AppFrame draws the rest. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/sw_window_bg</item>
    </style>

    <!-- The system splash: the page ground and the mark, until the app has read the stored pairing and appearance. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sw_window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
