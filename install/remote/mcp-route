#!/bin/sh
# mcp-route: manage routes on the filament-kit router.
#   mcp-route add <name> <port>   route https://<host>/<name>/... to 127.0.0.1:<port>
#   mcp-route rm <name>           remove a route this tool made (other files are left alone)
#   mcp-route ls
# The backend must listen on 127.0.0.1:<port> and trust X-Forwarded-For from 127.0.0.1 only.
# <host> is the single line in /etc/mcp-router/host (written by `filament-kit modules apply`).
set -e
HOST=$(cat /etc/mcp-router/host)
DIR=/etc/nginx/mcp.d
TPL=/etc/mcp-router/route.template
MARK='written by mcp-route'
reload() {
  nginx -t -q || return 1
  # a stopped nginx picks the route up when it starts
  if systemctl is-active -q nginx; then systemctl reload nginx; fi
}
case "$1" in
  add)
    echo "$2" | grep -Eq '^[a-z][a-z0-9-]{1,30}$' || { echo "name: lowercase letters, digits, dashes"; exit 2; }
    echo "$3" | grep -Eq '^[0-9]{4,5}$' || { echo "port: 1024-65535"; exit 2; }
    install -d -m 755 "$DIR"
    if [ -e "$DIR/$2.conf" ] && ! grep -q "$MARK" "$DIR/$2.conf"; then echo "$DIR/$2.conf is not ours; leaving it"; exit 2; fi
    grep -l "127.0.0.1:$3" "$DIR"/*.conf 2>/dev/null | grep -v "/$2.conf" && { echo "port $3 already routed"; exit 2; }
    sed "s/@NAME@/$2/g; s/@PORT@/$3/g; s/@HOST@/$HOST/g" "$TPL" > "$DIR/$2.conf.new"
    mv "$DIR/$2.conf.new" "$DIR/$2.conf"
    reload && echo "routed https://$HOST/$2/ -> 127.0.0.1:$3" ;;
  rm)
    f="$DIR/$2.conf"
    [ -e "$f" ] || { echo "no route $2"; exit 0; }
    grep -q "$MARK" "$f" || { echo "$f is not ours; leaving it"; exit 2; }
    rm -f "$f" && reload && echo "removed $2" ;;
  ls)
    for f in "$DIR"/*.conf; do [ -e "$f" ] || continue; n=$(basename "$f" .conf); p=$(grep -o '127.0.0.1:[0-9]*' "$f" | head -1); echo "$n  https://$HOST/$n/  -> $p"; done ;;
  *) sed -n '2,8p' "$0"; exit 2 ;;
esac
