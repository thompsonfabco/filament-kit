#!/bin/sh
# mcp-route: manage routes on the filament-kit router.
#   mcp-route add <name> <port>   route https://<host>/<name>/... to 127.0.0.1:<port>
#   mcp-route rm <name>           remove a route this tool made (other files are left alone)
#   mcp-route ls
# The backend must listen on 127.0.0.1:<port> and trust X-Forwarded-For from 127.0.0.1 only.
# <host> is the single line in /etc/mcp-router/host (written by `filament-kit modules apply`).
set -e
HOST=$(cat /etc/mcp-router/host)
DIR=/etc/nginx/mcp.d
TPL=/etc/mcp-router/route.template
MARK='written by filament-kit mcp-route'
# the filament-ops router writes the old marker too (as the kit did before v0.3.0): a file with it is ours only when
# /etc/mcp-router/kit-routes lists it
OLD_MARK='written by mcp-route'
BOOK=/etc/mcp-router/kit-routes
ours() {
  head -n 1 "$1" | grep -qF "$MARK" && return 0
  head -n 1 "$1" | grep -qF "$OLD_MARK" && [ -f "$BOOK" ] && tr -s '[:space:]' '\n' < "$BOOK" | grep -qxF "$2"
}
reload() {
  nginx -t -q || return 1
  # a stopped nginx picks the route up when it starts
  if systemctl is-active -q nginx; then systemctl reload nginx; fi
}
case "$1" in
  add)
    echo "$2" | grep -Eq '^[a-z][a-z0-9-]{1,30}$' || { echo "name: lowercase letters, digits, dashes"; exit 2; }
    echo "$3" | grep -Eq '^[0-9]{4,5}$' || { echo "port: 1024-65535"; exit 2; }
    install -d -m 755 "$DIR"
    # add may take over a route any mcp-route wrote (the ops cut-over: the kit replaces the ops `filament` route
    # with its own); a hand-written file stays. rm removes only routes that are ours.
    if [ -e "$DIR/$2.conf" ] && ! ours "$DIR/$2.conf" "$2" && ! head -n 1 "$DIR/$2.conf" | grep -qF "$OLD_MARK"; then
      echo "$DIR/$2.conf is not ours; leaving it"; exit 2
    fi
    grep -l "127.0.0.1:$3" "$DIR"/*.conf 2>/dev/null | grep -v "/$2.conf" && { echo "port $3 already routed"; exit 2; }
    rm -f "$DIR/$2.conf.old"
    [ -e "$DIR/$2.conf" ] && cp -p "$DIR/$2.conf" "$DIR/$2.conf.old"
    sed "s/@NAME@/$2/g; s/@PORT@/$3/g; s/@HOST@/$HOST/g" "$TPL" > "$DIR/$2.conf.new"
    mv "$DIR/$2.conf.new" "$DIR/$2.conf"
    if reload; then
      rm -f "$DIR/$2.conf.old"
      echo "routed https://$HOST/$2/ -> 127.0.0.1:$3"
    else
      # a bad route must not stay on disk: the next nginx start would fail
      if [ -e "$DIR/$2.conf.old" ]; then mv "$DIR/$2.conf.old" "$DIR/$2.conf"; else rm -f "$DIR/$2.conf"; fi
      echo "nginx rejected the route; restored the previous state"; exit 1
    fi ;;
  rm)
    f="$DIR/$2.conf"
    [ -e "$f" ] || { echo "no route $2"; exit 0; }
    ours "$f" "$2" || { echo "$f is not ours; leaving it"; exit 2; }
    rm -f "$f" && reload && echo "removed $2" ;;
  ls)
    for f in "$DIR"/*.conf; do [ -e "$f" ] || continue; n=$(basename "$f" .conf); p=$(grep -o '127.0.0.1:[0-9]*' "$f" | head -1); echo "$n  https://$HOST/$n/  -> $p"; done ;;
  *) sed -n '2,8p' "$0"; exit 2 ;;
esac
