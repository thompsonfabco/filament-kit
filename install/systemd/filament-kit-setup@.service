[Unit]
Description=filament-kit setup page helper (one request)
# Started by filament-kit-setup.socket per connection. Reads one JSON request from the socket, answers one line,
# exits. A closed list of operations (filament_kit/setup_helper.py), never a command or a path.

[Service]
Type=simple
ExecStart=/opt/filament-kit/venv/bin/python -I -m filament_kit.setup_helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=120
# root, but it may only write the kit's settings folder (and start the job units over systemd's bus): chown and
# mode changes of the files it writes there, nothing else. A restore adds two: the root-only backups folder, where the
# page's upload is pinned (backup.pin_upload), and the upload's own folder, from which that file is then removed. The
# "-" skips a folder that is not there (no upload waiting).
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/filament-kit -/var/backups/filament-kit -/var/lib/filament-kit/restore-upload
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
