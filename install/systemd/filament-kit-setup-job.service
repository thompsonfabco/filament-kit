[Unit]
Description=filament-kit background job, started from the setup page (apply, update, rollback, check for updates)
# Its own unit, so a job goes on while it restarts the kit server (and the page with it). It is no module's unit: an
# update stops the modules' units, never this one. The output goes to /run/filament-kit-setup/job.log
# (root:filament-kit 640), which the page shows.

[Service]
Type=oneshot
# a job may install packages (apt), download a release or the library
TimeoutStartSec=60min
ExecStart=/opt/filament-kit/venv/bin/python -I -m filament_kit.setup_helper job-run
